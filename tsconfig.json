{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true, "skipLibCheck": true,
    "types": ["node"], "baseUrl": ".",
    "paths": {
      "@silbenflug/shared": ["packages/shared/src/index.ts"],
      "@silbenflug/core": ["packages/core/src/index.ts"],
      "@silbenflug/engine": ["packages/engine/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "apps/*/scripts", "tests"]
}
