{
  "name": "silbenflug",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:kids": "node apps/kids/build.mjs",
    "build:web": "node apps/web/build.mjs",
    "build": "npm run build:kids && npm run build:web",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
